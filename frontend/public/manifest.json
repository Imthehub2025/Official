{
  "name": "Quantum Media Hub - Ultimate Sovereign Streaming Platform",
  "short_name": "Quantum Media Hub",
  "description": "Revolutionary streaming platform with AI, sovereignty mode, and XR support",
  "version": "2.0.0",
  "start_url": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#667eea",
  "background_color": "#1a1a2e",
  "scope": "/",
  "categories": ["entertainment", "multimedia", "productivity"],
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
