    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-home.png",
      "sizes": "1280x720",
      "type": "image/png",
      "platform": "wide",
      "label": "Quantum Media Hub Home Screen"
    },
    {
      "src": "/screenshots/mobile-sovereignty.png",
      "sizes": "640x1136",
      "type": "image/png",
      "platform": "narrow",
      "label": "Sovereignty Mode Toggle"
    }
  ],
  "features": [
    "Cross Platform",
    "Background Sync",
    "Web Share",
    "Fullscreen",
    "Install Prompt"
  ],
  "shortcuts": [
    {
      "name": "AI Recommendations",
      "short_name": "AI Recs",
      "description": "View AI-powered content recommendations",
      "url": "/ai-recommendations",
      "icons": [
        {
          "src": "/icons/shortcut-ai.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Sovereignty Mode",
      "short_name": "Sovereignty",
      "description": "Toggle sovereignty mode",
      "url": "/sovereignty",
      "icons": [
        {
          "src": "/icons/shortcut-sovereignty.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Voice Commands",
      "short_name": "Voice",
      "description": "Activate voice command interface",
      "url": "/voice",
      "icons": [
        {
          "src": "/icons/shortcut-voice.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "XR Experience",
      "short_name": "XR",
      "description": "Launch XR/VR streaming experience",
      "url": "/xr",
      "icons": [
        {
          "src": "/icons/shortcut-xr.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+quantummedia",
      "url": "/handle-protocol?url=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/upload",
      "accept": {
        "video/*": [".mp4", ".mkv", ".avi", ".mov", ".wmv", ".webm"],
        "audio/*": [".mp3", ".aac", ".flac", ".wav", ".ogg"]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["video/*", "audio/*", "image/*"]
        }
      ]
    }
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.quantum.mediahub",
      "id": "com.quantum.mediahub"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/quantum-media-hub/id123456789"
    }
  ]
}