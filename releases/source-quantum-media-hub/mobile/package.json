{
  "name": "quantum-media-hub-mobile",
  "version": "2.0.0",
  "description": "Quantum Media Hub Mobile Application",
  "main": "index.js",
  "scripts": {
    "build": "cd ../frontend && yarn build",
    "sync": "npx cap sync",
    "sync:android": "npx cap sync android",
    "sync:ios": "npx cap sync ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "run:android": "npx cap run android",
    "run:ios": "npx cap run ios",
    "build:android": "npm run build && npm run sync:android && npx cap build android",
    "build:ios": "npm run build && npm run sync:ios && npx cap build ios",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "clean": "npx cap clean",
    "doctor": "npx cap doctor",
    "serve": "npx cap serve",
    "copy": "npx cap copy",
    "update": "npx cap update",
    "generate-icons": "cordova-res android --skip-config --copy && cordova-res ios --skip-config --copy",
    "generate-splash": "cordova-res android --skip-config --copy --type splash && cordova-res ios --skip-config --copy --type splash"
  },
  "dependencies": {
    "@capacitor/android": "^5.6.0",
    "@capacitor/ios": "^5.6.0",
    "@capacitor/core": "^5.6.0",
    "@capacitor/cli": "^5.6.0",
    "@capacitor/app": "^5.0.6",
    "@capacitor/haptics": "^5.0.6",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/status-bar": "^5.0.6",
    "@capacitor/splash-screen": "^5.0.6",
    "@capacitor/device": "^5.0.6",
    "@capacitor/network": "^5.0.6",
    "@capacitor/geolocation": "^5.0.6",
    "@capacitor/camera": "^5.0.6",
    "@capacitor/filesystem": "^5.1.4",
    "@capacitor/share": "^5.0.6",
    "@capacitor/toast": "^5.0.6",
    "@capacitor/dialog": "^5.0.6",
    "@capacitor/local-notifications": "^5.0.6",
    "@capacitor/push-notifications": "^5.1.0",
    "@capacitor/browser": "^5.0.6",
    "@capacitor-community/bluetooth-le": "^3.1.2",
    "@capacitor-community/media": "^5.0.0",
    "@capacitor-community/screen-orientation": "^5.0.0",
    "@capacitor-community/keep-awake": "^5.0.0"
  },
  "devDependencies": {
    "cordova-res": "^0.15.4"
  },
  "keywords": [
    "capacitor",
    "mobile",
    "ionic",
    "streaming",
    "media",
    "quantum"
  ],
  "author": "Quantum Development Team",
  "license": "MIT"
}